        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;ChainWalker.walk()  ·  walker.py (2,653)  —  BFS per hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;1 · SSH to next IP from queue        5 · build Hop = the four questions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;2 · fingerprint (prompt→version)     6 · assign HopVerdict&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;3 · extract hostname (= identity)    7 · enqueue next-hop IPs (≥2 = ECMP)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;4 · run per-platform commands        →  emit HopEvent (events.py seam)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;visited-check by HOSTNAME, not IP — loops &amp;amp; shared transits handled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0f6;strokeColor=#036897;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="440" y="316" width="720" height="210" as="geometry" />
        </mxCell>
        <mxCell id="n_fq" value="THE FOUR QUESTIONS  ·  models.py  —  vendor-neutral, forwarding-plane only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;dashed=1;strokeWidth=1;fontColor=#036897;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingTop=6;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="420" y="556" width="760" height="214" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;1 · Route?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;RIB — RouteEntry&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#036897;strokeColor=#ffffff;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
