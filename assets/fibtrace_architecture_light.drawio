        <mxCell id="n28" value="&lt;b&gt;→ HopVerdict&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#334155&quot;&gt;healthy · rib-only · no-route · blackhole · incomplete-arp · interface-down · interface-errors · convergence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#036897;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;strokeWidth=1.5;" parent="1" vertex="1">
