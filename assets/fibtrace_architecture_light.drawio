        <mxCell id="n25" value="&lt;b&gt;2 · In FIB?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;FibEntry · RIB-only = trouble&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0a76a8;strokeColor=#ffffff;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
