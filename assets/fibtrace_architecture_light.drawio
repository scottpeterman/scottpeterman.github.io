        <mxCell id="n15" value="&lt;b&gt;Fingerprint  ·  commands_and_parsers.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;prompt → show version&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;cisco_ios · cisco_nxos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;arista_eos · juniper_junos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ef;strokeColor=#2D8659;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;" parent="1" vertex="1">
