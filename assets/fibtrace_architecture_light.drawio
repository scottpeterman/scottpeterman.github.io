        <mxCell id="n21" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;target prefix + seed device IP  →  CLI · TUI (Textual) · web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;" parent="1" vertex="1">
