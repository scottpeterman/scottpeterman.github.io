        <mxCell id="n34" value="&lt;b&gt;fibtrace-diff  ·  diff.py (675)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;two graph JSONs → compute_impairment()&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;signed Δ: paths · edges · ECMP-width&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;CRITICAL ≤ −50%  ·  WARNING ≤ −25%&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;out: one-line summary · JSON delta&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;· MOP-ready markdown report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;strokeWidth=2;" parent="1" vertex="1">
