        <mxCell id="n29" value="&lt;b&gt;Forwarding Graph (DAG)  ·  forwarding_graph.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;nodes = hostnames · edges = forwarding decisions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;ECMP = &amp;gt;1 out-edge · convergence = &amp;gt;1 in-edge · one HopEvent → one mutation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0e6;strokeColor=#F58536;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;strokeWidth=2;" parent="1" vertex="1">
