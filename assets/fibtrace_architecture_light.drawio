        <mxCell id="n20" value="&lt;b&gt;Diagnostics  ·  diagnostics.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;3 levels: chain / hop / raw capture&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;&quot;if a parser returns None, know WHY&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ef;strokeColor=#2D8659;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;dashed=1;" parent="1" vertex="1">
