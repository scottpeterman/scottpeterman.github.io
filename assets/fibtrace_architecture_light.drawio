        <mxCell id="n27" value="&lt;b&gt;4 · Link healthy?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;iface state + counters&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#38a5da;strokeColor=#ffffff;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
