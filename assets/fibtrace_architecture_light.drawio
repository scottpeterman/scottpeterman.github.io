        <mxCell id="n11" value="NOT A TRACEROUTE  —  forwarding validation from the device&#39;s own perspective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;dashed=1;strokeWidth=1;fontColor=#2D8659;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingTop=6;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="40" y="50" width="1620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;traceroute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;outside-in · ICMP TTL exhaustion · sees hop IPs only.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;Blind to RIB-vs-FIB divergence, incomplete ARP, and any&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;ECMP path the probe didn&#39;t happen to hash into.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="70" y="92" width="760" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;fibtrace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;inside-out · SSH into each device, read its OWN RIB / FIB /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;ARP / interfaces. Identity = CLI-prompt hostname, not IP.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569&quot;&gt;Four forwarding questions asked at every hop.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4ef;strokeColor=#2D8659;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingLeft=10;arcSize=6;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="860" y="92" width="770" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="MULTI-VENDOR PARSE  ·  parsers.py (2,048)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;dashed=1;strokeWidth=1;fontColor=#2D8659;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacing=6;spacingLeft=10;spacingTop=6;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="40" y="220" width="340" height="660" as="geometry" />
